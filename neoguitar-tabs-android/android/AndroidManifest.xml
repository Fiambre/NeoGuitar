<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fiambre.neoguitar.tabs">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- To hand the downloaded file to NeoGuitar. -->
    <queries>
        <package android:name="com.fiambre.neoguitar" />
    </queries>

    <application
        android:label="NeoGuitar Tabs"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name="com.fiambre.neoguitar.tabs.TabsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.fiambre.neoguitar.tabs.TabsProvider"
            android:authorities="com.fiambre.neoguitar.tabs.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
